{
  "name": "backrooms-studio-vicenza",
  "version": "1.0.0",
  "private": true,
  "description": "Landing page dello studio di registrazione a Vicenza e Backrooms Beat Store",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "audio:demo": "node scripts/generate-demo-audio.mjs",
    "postinstall": "prisma generate",
    "test:beats": "node --import tsx --test tests/beats/*.test.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.1",
    "@tanstack/react-query": "^5.104.5",
    "framer-motion": "^13.4.4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.61.0",
    "next": "^16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "next-seo": "^7.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "postcss": "^8.5.28",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
