// Backrooms Beat Store · schema PostgreSQL
//
// Principi:
// - Il saldo crediti (`User.creditBalance`) è una cache: la fonte di verità è il libro mastro
//   append-only `CreditTransaction`. Ogni movimento aggiorna entrambi nella stessa transazione,
//   con un UPDATE condizionato (`creditBalance >= costo`) che rende impossibile il saldo negativo.
// - Due borse di crediti: `creditBalance` (abbonamento: rollover e scadenza a fine piano) e
//   `walletCredits` (ricariche, gift card, inviti: non scadono). Le spese pescano prima
//   dall'abbonamento, poi dal portafoglio; `balanceAfter` nel mastro è sempre il totale.
// - Ogni effetto di un webhook Stripe è idempotente: `StripeEvent` registra gli eventi già
//   elaborati e `CreditTransaction.idempotencyKey` impedisce doppi accrediti.
// - I file audio non sono mai pubblici: nel DB ci sono solo le chiavi degli oggetti su R2,
//   firmate al volo dopo il controllo della licenza.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Identità (tabelle standard Auth.js)
 */
/**
 * ------------------------------------------------------------------
 */

enum UserRole {
  ARTIST
  PRODUCER
  ADMIN
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  emailVerified    DateTime?
  image            String?
  artistName       String?
  /// Hash scrypt della password personale (null per chi entra solo con Google o link email).
  passwordHash     String?
  role             UserRole  @default(ARTIST)
  stripeCustomerId String?   @unique
  /// Crediti dell'abbonamento (cache): aggiornati solo insieme a una riga di CreditTransaction.
  creditBalance    Int       @default(0)
  /// Crediti del portafoglio (ricariche, gift card, inviti): non scadono mai.
  walletCredits    Int       @default(0)
  /// Codice personale per invitare altri artisti.
  referralCode     String?   @unique
  referredById     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  referredBy User?  @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals  User[] @relation("Referrals")

  accounts       Account[]
  sessions       Session[]
  subscriptions  Subscription[]
  transactions   CreditTransaction[]
  licenses       License[]
  downloads      Download[]
  projects       Project[]
  customizations CustomizationRequest[]
  producer       Producer?
  purchases      ProductPurchase[]
  orders         ServiceOrder[]
  bids           Bid[]
  auctionsWon    Auction[]              @relation("AuctionWinner")
  giftsBought    GiftCard[]             @relation("GiftPurchaser")
  giftsRedeemed  GiftCard[]             @relation("GiftRedeemer")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Abbonamenti e crediti
 */
/**
 * ------------------------------------------------------------------
 */

enum PlanTier {
  STARTER
  PRO
  ELITE
}

enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  PAUSED
  CANCELED
}

enum BillingInterval {
  MONTH
  YEAR
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  stripeSubscriptionId String             @unique
  stripePriceId        String
  tier                 PlanTier
  /// Annuale: un pagamento, crediti accreditati ogni mese dal cron.
  interval             BillingInterval    @default(MONTH)
  status               SubscriptionStatus
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  /// Pausa al posto della disdetta: niente addebiti né accrediti fino a questa data.
  pausedUntil          DateTime?
  lastPausedAt         DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@index([userId, status])
}

enum CreditTransactionType {
  /// Accredito mensile al pagamento della fattura.
  SUBSCRIPTION_GRANT
  /// Crediti oltre il tetto di rollover, azzerati prima del nuovo accredito.
  ROLLOVER_EXPIRY
  /// Crediti residui azzerati alla fine dell'abbonamento.
  SUBSCRIPTION_END_EXPIRY
  /// Spesa per sbloccare una licenza.
  UNLOCK
  /// Restituzione (licenza revocata, errore).
  REFUND
  /// Correzione manuale dello staff.
  ADJUSTMENT
  /// Omaggio (promozioni, sessioni in studio, referral).
  BONUS
  /// Spesa per una personalizzazione su richiesta.
  CUSTOMIZATION
  /// Ricarica comprata con carta (portafoglio).
  TOPUP
  /// Gift card riscattata (portafoglio).
  GIFT_REDEEM
  /// Premio per un invito andato a buon fine (portafoglio).
  REFERRAL
  /// Servizio dello studio pagato in crediti.
  SERVICE
  /// Drum kit, sample pack o preset pagato in crediti.
  PRODUCT
}

model CreditTransaction {
  id              String                @id @default(cuid())
  userId          String
  type            CreditTransactionType
  /// Positivo = accredito, negativo = addebito (totale delle due borse).
  amount          Int
  /// Parte di `amount` che riguarda il portafoglio (il resto riguarda i crediti dell'abbonamento).
  walletAmount    Int                   @default(0)
  /// Saldo totale (abbonamento + portafoglio) dopo il movimento.
  balanceAfter    Int
  description     String?
  /// Chiave unica per gli effetti esterni (es. `grant:<invoiceId>`): rende idempotenti i webhook.
  idempotencyKey  String?               @unique
  subscriptionId  String?
  stripeInvoiceId String?
  licenseId       String?               @unique
  customizationId String?               @unique
  createdAt       DateTime              @default(now())

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription  Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  license       License?              @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  customization CustomizationRequest? @relation(fields: [customizationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
}

/// Eventi Stripe già elaborati (idempotenza dei webhook).
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Catalogo
 */
/**
 * ------------------------------------------------------------------
 */

model Producer {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  bio         String?
  avatarUrl   String?
  instagram   String?
  /// Produttore resident dello studio (filtro "Resident Producers").
  isResident  Boolean  @default(false)
  /// Colore d'accento per i tag del produttore (es. `#0066FF`).
  accentColor String?
  userId      String?  @unique
  createdAt   DateTime @default(now())

  user     User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  beats    BeatProducer[]
  products Product[]
}

enum BeatStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum KeyMode {
  MAJOR
  MINOR
}

model Beat {
  id                 String                   @id @default(cuid())
  slug               String                   @unique
  title              String
  description        String?
  status             BeatStatus               @default(DRAFT)
  bpm                Int
  /// Tonica come pitch class: 0 = C, 1 = C#/Db … 11 = B. La notazione Camelot è derivata.
  keyRoot            Int
  keyMode            KeyMode
  durationSec        Int
  moods              String[]
  coverUrl           String?
  /// Picchi della forma d'onda pre-calcolati all'upload (0..1, ~160 valori).
  waveformPeaks      Json
  /// Anteprima a basso bitrate con tag audio (unico file servito senza licenza).
  previewObjectKey   String
  mp3ObjectKey       String
  wavObjectKey       String
  stemsObjectKey     String?
  /// Cartella R2 con le anteprime degli stems per il mixer: `${prefix}/drums.mp3`, bass, keys, fx.
  stemPreviewPrefix  String?
  exclusiveAvailable Boolean                  @default(true)
  exclusiveSoldAt    DateTime?
  playCount          Int                      @default(0)
  downloadCount      Int                      @default(0)
  /// Titolo + produttori + generi + type beat + mood: alimenta la ricerca full-text e fuzzy.
  searchDocument     String                   @default("")
  /// Colonna generata da `searchDocument` (vedi migrazione): indice GIN full-text.
  searchVector       Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, COALESCE(\"searchDocument\", ''::text))"))
  releasedAt         DateTime                 @default(now())
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  producers      BeatProducer[]
  genres         Genre[]
  typeTags       TypeTag[]
  licenses       License[]
  deals          DailyDeal[]
  projects       Project[]
  customizations CustomizationRequest[]
  orders         ServiceOrder[]
  auctions       Auction[]

  @@index([status, releasedAt(sort: Desc)])
  @@index([bpm])
  @@index([keyRoot, keyMode])
  @@index([searchVector], type: Gin)
  @@index([searchDocument(ops: raw("gin_trgm_ops"))], type: Gin, map: "Beat_searchDocument_trgm_idx")
}

enum ProducerRole {
  MAIN
  CO_PRODUCER
}

model BeatProducer {
  beatId     String
  producerId String
  role       ProducerRole @default(MAIN)
  /// Quota dei ricavi del beat (0-100) per la ripartizione tra i produttori.
  splitPct   Int          @default(100)

  beat     Beat     @relation(fields: [beatId], references: [id], onDelete: Cascade)
  producer Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  @@id([beatId, producerId])
  @@index([producerId])
}

/// Tassonomia ad albero: Trap → Plugg, Drill → UK Drill …
model Genre {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  parentId String?

  parent   Genre?  @relation("GenreTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Genre[] @relation("GenreTree")
  beats    Beat[]
}

/// "Type beat": riferimento artistico (Travis Scott Type, Drake Type …).
model TypeTag {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  beats Beat[]
}

/// Beat del giorno: sconto a tempo su tutte le licenze.
model DailyDeal {
  id          String   @id @default(cuid())
  beatId      String
  discountPct Int
  startsAt    DateTime
  endsAt      DateTime

  beat Beat @relation(fields: [beatId], references: [id], onDelete: Cascade)

  @@index([startsAt, endsAt])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Licenze e download
 */
/**
 * ------------------------------------------------------------------
 */

enum LicenseType {
  MP3_LEASE
  WAV_LEASE
  TRACKOUT
  UNLIMITED
}

enum LicenseStatus {
  ACTIVE
  REVOKED
}

model License {
  id           String        @id @default(cuid())
  userId       String
  beatId       String
  type         LicenseType
  status       LicenseStatus @default(ACTIVE)
  creditsSpent Int
  /// Copia dei termini al momento dell'acquisto (stream massimi, copie, ecc.).
  terms        Json
  createdAt    DateTime      @default(now())

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  beat        Beat               @relation(fields: [beatId], references: [id], onDelete: Restrict)
  transaction CreditTransaction?
  downloads   Download[]

  @@unique([userId, beatId, type])
  @@index([userId, createdAt(sort: Desc)])
}

enum DownloadAsset {
  MP3
  WAV
  STEMS
}

model Download {
  id        String        @id @default(cuid())
  userId    String
  licenseId String
  asset     DownloadAsset
  ipHash    String?
  userAgent String?
  createdAt DateTime      @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Progetti in studio (ponte tra beat store e servizi dello studio)
 */
/**
 * ------------------------------------------------------------------
 */

enum ProjectStatus {
  DRAFT
  IN_STUDIO
  DELIVERED
}

model Project {
  id        String        @id @default(cuid())
  userId    String
  beatId    String?
  title     String
  summary   String
  status    ProjectStatus @default(DRAFT)
  dueAt     DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  beat Beat? @relation(fields: [beatId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt(sort: Desc)])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Personalizzazioni su richiesta
 */
/**
 * ------------------------------------------------------------------
 */

enum CustomizationStatus {
  REQUESTED
  IN_PROGRESS
  DELIVERED
  REFUNDED
}

/// Richiesta di personalizzare un beat del catalogo (tonalità, BPM, struttura, suoni…), pagata in crediti.
model CustomizationRequest {
  id                String              @id @default(cuid())
  userId            String
  beatId            String
  /// Voci scelte (vedi lib/beats/customizations.ts).
  options           String[]
  express           Boolean             @default(false)
  notes             String
  referenceUrl      String?
  creditsSpent      Int
  status            CustomizationStatus @default(REQUESTED)
  dueAt             DateTime
  deliveredAt       DateTime?
  /// File consegnato su R2 (versione personalizzata).
  deliveryObjectKey String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  beat        Beat               @relation(fields: [beatId], references: [id], onDelete: Restrict)
  transaction CreditTransaction?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, dueAt])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Prodotti digitali: drum kit, sample pack, preset voce
 */
/**
 * ------------------------------------------------------------------
 */

enum ProductKind {
  DRUM_KIT
  SAMPLE_PACK
  VOCAL_PRESET
}

enum PaymentMethod {
  CREDITS
  CARD
}

model Product {
  id               String      @id @default(cuid())
  slug             String      @unique
  kind             ProductKind
  title            String
  description      String
  /// Contenuto in breve ("42 one-shot", "Preset per FL Studio e Logic").
  contents         String[]
  producerId       String?
  priceCents       Int
  credits          Int
  coverColor       String      @default("#0066ff")
  previewObjectKey String?
  /// Archivio ZIP su R2, firmato al volo solo per chi l'ha comprato.
  objectKey        String
  published        Boolean     @default(true)
  createdAt        DateTime    @default(now())

  producer  Producer?         @relation(fields: [producerId], references: [id], onDelete: SetNull)
  purchases ProductPurchase[]

  @@index([published, kind])
}

model ProductPurchase {
  id              String        @id @default(cuid())
  userId          String
  productId       String
  paidWith        PaymentMethod
  creditsSpent    Int           @default(0)
  amountCents     Int           @default(0)
  stripeSessionId String?       @unique
  createdAt       DateTime      @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([userId, productId])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Servizi dello studio: pacchetto hit, mix & master, feedback, live, uscita
 */
/**
 * ------------------------------------------------------------------
 */

enum ServiceKind {
  HIT_PACKAGE
  MIX_MASTER
  FEEDBACK
  LIVE_SLOT
  RELEASE
}

enum ServiceOrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PROGRESS
  DELIVERED
  CANCELED
  REFUNDED
}

/// Ordine di un servizio (vedi lib/beats/offers.ts per livelli e prezzi).
model ServiceOrder {
  id                String             @id @default(cuid())
  userId            String
  kind              ServiceKind
  tierId            String
  beatId            String?
  notes             String
  /// Data o fascia preferita (feedback, live, sessione in studio).
  scheduledFor      DateTime?
  paidWith          PaymentMethod
  creditsSpent      Int                @default(0)
  amountCents       Int                @default(0)
  /// Sconto del livello Resident applicato al prezzo in euro.
  discountPct       Int                @default(0)
  stripeSessionId   String?            @unique
  status            ServiceOrderStatus @default(PENDING_PAYMENT)
  deliveredAt       DateTime?
  deliveryObjectKey String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  beat Beat? @relation(fields: [beatId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([kind, status, scheduledFor])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Aste delle esclusive (anche in diretta TikTok tramite l'overlay)
 */
/**
 * ------------------------------------------------------------------
 */

enum AuctionStatus {
  /// Aperta (o programmata, se `startsAt` è nel futuro).
  OPEN
  /// Chiusa: il vincitore ha `paymentDueAt` per pagare.
  AWAITING_PAYMENT
  PAID
  /// Chiusa senza offerte valide o senza pagamento.
  UNSOLD
}

model Auction {
  id                String        @id @default(cuid())
  beatId            String
  startsAt          DateTime
  endsAt            DateTime
  startPriceCents   Int
  minIncrementCents Int
  status            AuctionStatus @default(OPEN)
  /// Asta legata a una diretta (mostrata dall'overlay TikTok).
  live              Boolean       @default(false)
  winnerId          String?
  winningBidCents   Int?
  paymentDueAt      DateTime?
  /// Vincitori che non hanno pagato in tempo (l'esclusiva passa all'offerta successiva).
  skippedUserIds    String[]
  stripeSessionId   String?       @unique
  paidAt            DateTime?
  createdAt         DateTime      @default(now())

  beat   Beat  @relation(fields: [beatId], references: [id], onDelete: Restrict)
  winner User? @relation("AuctionWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  bids   Bid[]

  @@index([status, endsAt])
}

model Bid {
  id          String   @id @default(cuid())
  auctionId   String
  userId      String
  amountCents Int
  createdAt   DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([auctionId, amountCents])
  @@index([auctionId, createdAt(sort: Desc)])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Gift card di crediti
 */
/**
 * ------------------------------------------------------------------
 */

model GiftCard {
  id              String    @id @default(cuid())
  /// Codice da riscattare (es. BR-7KQ2-M9XA).
  code            String    @unique
  credits         Int
  amountCents     Int
  recipientName   String?
  message         String?
  purchaserId     String?
  stripeSessionId String?   @unique
  redeemedById    String?
  redeemedAt      DateTime?
  createdAt       DateTime  @default(now())

  purchaser  User? @relation("GiftPurchaser", fields: [purchaserId], references: [id], onDelete: SetNull)
  redeemedBy User? @relation("GiftRedeemer", fields: [redeemedById], references: [id], onDelete: SetNull)
}
