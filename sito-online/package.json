{
  "name": "backrooms-sito-online",
  "private": true,
  "description": "Sito statico di backroomsstudio.it con checkout (calendario Google, Stripe, contanti) su Netlify Functions",
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "build": "esbuild src/prenota/main.ts --bundle --minify --format=iife --target=es2019 --outfile=public/js/prenota.js",
    "dev": "npm run build && node --experimental-strip-types scripts/dev.mjs",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "nodemailer": "10.6.1",
    "stripe": "23.2.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
