# URL pubblico definitivo del sito (usato per canonical, sitemap, OpenGraph e JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.backroomsstudio.it

# Google Analytics 4 (facoltativo): ID di misurazione, formato G-XXXXXXXXXX
# (Analytics → Amministrazione → Stream di dati → web). Vuoto = nessun tracciamento e nessun banner.
# Con l'ID, Analytics parte solo dopo il consenso del visitatore.
NEXT_PUBLIC_GA_ID=

# ------------------------------------------------------------------
# Prenotazioni e pagamenti online (/prenota). Vedi docs/prenotazioni-online.md
# ------------------------------------------------------------------
# Stripe → Sviluppatori → Chiavi API (sk_live_... in produzione, sk_test_... per le prove)
STRIPE_SECRET_KEY=
# Stripe → Sviluppatori → Webhook → endpoint https://www.backroomsstudio.it/api/stripe/webhook → "Segreto di firma"
STRIPE_WEBHOOK_SECRET=

# Google Cloud → account di servizio con chiave JSON: copia "client_email" e "private_key"
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Calendario dove scrivere le prenotazioni (di default l'email dello studio)
GOOGLE_CALENDAR_ID=backrooms.studios.vi@gmail.com
# Calendari che rendono "occupato" uno slot, separati da virgola (di default solo quello sopra)
GOOGLE_BUSY_CALENDAR_IDS=

# Email di notifica: Gmail dello studio + "password per le app" (Account Google → Sicurezza)
SMTP_USER=
SMTP_PASS=
# Chi riceve le notifiche dei nuovi acquisti, separati da virgola (di default l'email dello studio)
NOTIFY_EMAILS=
