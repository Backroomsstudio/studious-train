# URL pubblico definitivo del sito (usato per canonical, sitemap, OpenGraph e JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.backroomsstudio.it

# Google Analytics 4 (facoltativo): ID di misurazione, formato G-XXXXXXXXXX
# (Analytics → Amministrazione → Stream di dati → web). Vuoto = nessun tracciamento e nessun banner.
# Con l'ID, Analytics parte solo dopo il consenso del visitatore.
NEXT_PUBLIC_GA_ID=

# ------------------------------------------------------------------
# Backrooms Beat Store (/beats)
# Senza DATABASE_URL il negozio gira in modalità demo (catalogo in memoria, audio sintetizzato).
# ------------------------------------------------------------------
DATABASE_URL=
# BEATS_DEMO_MODE=1        # forza la demo anche con il database configurato

# Auth.js: `npx auth secret` genera il segreto. Almeno un metodo di accesso.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="Backrooms Beat Store <beats@backroomsstudio.it>"

# Stripe Billing: un prezzo mensile ricorrente per piano (29,90 / 39,90 / 49,99 €)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=

# Cloudflare R2 (bucket privato con anteprime, master e stems)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Firma dei link di download (se vuoto usa AUTH_SECRET)
DOWNLOAD_GRANT_SECRET=
