# URL pubblico definitivo del sito (usato per canonical, sitemap, OpenGraph e JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.backroomsstudio.it

# Google Analytics 4 (facoltativo): ID di misurazione, formato G-XXXXXXXXXX
# (Analytics → Amministrazione → Stream di dati → web). Vuoto = nessun tracciamento e nessun banner.
# Con l'ID, Analytics parte solo dopo il consenso del visitatore.
NEXT_PUBLIC_GA_ID=
