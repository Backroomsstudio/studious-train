# URL pubblico definitivo del sito (usato per canonical, sitemap, OpenGraph e JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.backroomsstudio.it

# Google Analytics 4 (facoltativo): ID di misurazione, formato G-XXXXXXXXXX
# (Analytics → Amministrazione → Stream di dati → web). Vuoto = nessun tracciamento e nessun banner.
# Con l'ID, Analytics parte solo dopo il consenso del visitatore.
NEXT_PUBLIC_GA_ID=

# ------------------------------------------------------------------
# Backrooms Beat Store (/beats)
# Senza DATABASE_URL il negozio gira in modalità demo (catalogo in memoria, audio sintetizzato).
# ------------------------------------------------------------------
DATABASE_URL=
# BEATS_DEMO_MODE=1        # forza la demo anche con il database configurato

# Lancio pubblico: prima di questa data entra solo lo staff, il pubblico vede /beats/presto con la lista d'attesa.
# Vuota = negozio aperto a tutti.
STORE_LAUNCH_AT=2027-01-01T00:00:00+01:00
# Codici d'invito dello staff (uno per producer, 6-16 lettere o numeri): chi si registra con il codice
# diventa admin, entra nella Gestione e firma i beat di quel profilo. Ogni codice vale una volta.
STAFF_INVITES=astral:CODICE1,freya:CODICE2,plugghe:CODICE3

# Auth.js: `npx auth secret` genera il segreto. Almeno un metodo di accesso.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="Backrooms Beat Store <beats@backroomsstudio.it>"

# Stripe Billing: un prezzo mensile ricorrente per piano (29,90 / 39,90 / 49,99 €)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=
# Piani annuali (10 mesi pagati, 12 di crediti): 299 € / 399 € / 499,90 €
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ELITE_YEARLY=
# Cron orario (crediti mensili degli annuali, chiusura aste): GET /api/cron/scheduled con "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Origini che possono leggere /api/live/overlay (app overlay-live della diretta TikTok), separate da virgola. Vuoto = tutte.
LIVE_OVERLAY_ORIGINS=

# Archivio file privato (anteprime, master, stems, kit). Di base Cloudflare R2 con l'ID account;
# per un altro S3 (es. Supabase Storage) usa R2_ENDPOINT + R2_REGION al posto di R2_ACCOUNT_ID.
# I caricamenti dalla Gestione vanno diretti dal browser al bucket: su R2 premi una volta
# "Prepara l'archivio per i caricamenti" (Gestione → Profilo) per la regola CORS.
R2_ACCOUNT_ID=
# R2_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
# R2_REGION=eu-central-1
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Firma dei link di download (se vuoto usa AUTH_SECRET)
DOWNLOAD_GRANT_SECRET=
